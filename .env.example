# Anthropic API key. Used only by server-side route handlers, never sent to the browser.
ANTHROPIC_API_KEY=
# Main model: summaries, interpretation, Q&A
MODEL_MAIN=claude-sonnet-5-5
# Fast model: edge explanations, short labels
MODEL_FAST=claude-haiku-5-5
# When true, never call the API; serve cached outputs from data/cache only (demo safety)
USE_CACHE_ONLY=false
