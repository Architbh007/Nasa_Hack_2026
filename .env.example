# Copy this file to .env.local (git-ignored) and put your real key there, never here.
# OpenAI API key. Used only by server-side route handlers, never sent to the browser.
OPENAI_API_KEY=
# Main model: summaries, habitat interpretation, cabin Q&A
MODEL_MAIN=gpt-6.1-sol
# Fast model: Fire Twin narration and Then vs Now lessons
MODEL_FAST=gpt-6-luna
# When true, never call the API; serve cached outputs from data/cache only (demo safety)
USE_CACHE_ONLY=false
# Seed for the synthetic data generator
DATA_SEED=42
